generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lawyer {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  country      String?
  practiceAreas String[]
  cases        Case[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Case {
  id          String        @id @default(cuid())
  title       String
  caseNumber  String?
  status      String        @default("active")
  practiceArea String?
  jurisdiction String?
  lawyerId    String
  lawyer      Lawyer        @relation(fields: [lawyerId], references: [id])
  documents   Document[]
  facts       Fact[]
  evidence    Evidence[]
  docketEvents DocketEvent[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Fact {
  id        String   @id @default(cuid())
  text      String
  createdBy String?
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Document {
  id        String   @id @default(cuid())
  name      String
  type      String?
  content   String?
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Evidence {
  id        String   @id @default(cuid())
  name      String
  kind      String?
  notes     String?
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model DocketEvent {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  status    String?
  notes     String?
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
